{
    "name": "blocks-renderer-angular",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "start:playground": "ng serve --project=playground",
        "build:lib": "ng build --project=blocks-renderer-angular",
        "build:playground": "ng build --project=playground",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "ng lint",
        "format": "prettier --write \"projects/**/*.{ts,html,scss}\"",
        "copy-readme": "cp README.md dist/blocks-renderer-angular/README.md",
        "publish:lib": "pnpm build:lib && pnpm copy-readme && cd dist/blocks-renderer-angular && pnpm publish",
        "publish:lib:dry-run": "pnpm build:lib && pnpm copy-readme && cd dist/blocks-renderer-angular && pnpm publish --dry-run --no-git-checks",
        "release": "semantic-release"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "tabWidth": 4,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "pnpm@11.13.1",
    "dependencies": {
        "@angular/common": "^21.0.0",
        "@angular/compiler": "^21.0.0",
        "@angular/core": "^21.0.0",
        "@angular/forms": "^21.0.0",
        "@angular/platform-browser": "^21.0.0",
        "@angular/router": "^21.0.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.1.1",
        "@angular/cli": "^21.0.4",
        "@angular/compiler-cli": "^21.0.0",
        "angular-eslint": "21.1.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "jsdom": "^27.1.0",
        "ng-packagr": "^21.1.0",
        "prettier": "^3.8.1",
        "typescript": "~5.9.2",
        "typescript-eslint": "8.47.0",
        "vitest": "^4.0.8",
        "semantic-release": "^24.2.0",
        "@semantic-release/changelog": "^6.0.0",
        "@semantic-release/exec": "^7.0.0",
        "@semantic-release/git": "^10.0.0",
        "@semantic-release/github": "^9.0.0",
        "@semantic-release/npm": "^12.0.0"
    }
}
